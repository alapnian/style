{
  "name": "@alapnian/style",
  "version": "1.0.0",
  "description": "A free and open-source front-end framework used for designing and developing websites. It provides a collection of ready-to-use CSS, JavaScript, and HTML that makes it easy for developers to create responsive designs and consistent displays across devices.",
