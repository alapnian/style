    "framework",
    "web",
    "scss",
    "html",
    "javascript",
    "css-framework"
  ],
  "main": "dist/scripts/alapnian.js",
  "module": "dist/scripts/alapnian.esm.js",
  "style": "dist/stylesheets/alapnian.css",
